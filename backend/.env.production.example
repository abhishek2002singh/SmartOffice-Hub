# AMS Production Environment — copy to .env and fill in real values
# NEVER commit the actual .env file

NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string (use M10+ cluster for prod)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ams_prod?retryWrites=true&w=majority

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<64-char-hex-string>
JWT_REFRESH_SECRET=<different-64-char-hex-string>
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# CORS — frontend origin in production
CLIENT_URL=https://ams.ankdigitalmedia.com

# Google Drive API credentials
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://ams.ankdigitalmedia.com/oauth/callback
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Logging
LOG_LEVEL=info
